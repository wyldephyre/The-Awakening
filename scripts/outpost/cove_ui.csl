draw_cove_panel :: proc(player: Player) {
    if player.outpost == null return;

    UI.push_layer_relative(45);
    defer UI.pop_layer();

    safe := UI.get_safe_screen_rect();
    panel := safe.bottom_rect().grow_top(220).inset(12, 70, 12, 70);
    UI.quad(panel, core_globals.white_sprite, {0.07, 0.08, 0.10, 0.90});

    header := panel.cut_top(42);
    ts := UI.default_text_settings();
    ts.size = 30;
    ts.color = {0.95, 0.82, 0.55, 1};
    ts.halign = .CENTER;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 2;
    ts.outline_color = {0, 0, 0, 1};
    UI.text(header, ts, "Corsair Cove — Lumber");

    panel.cut_top(6);

    ts.size = 20;
    ts.color = {0.75, 0.75, 0.75, 1};
    ts.halign = .LEFT;
    blurb := panel.cut_top(36);
    UI.text(blurb, ts, "Canopy woodcutter -> Midcliff sawmill -> Docks warehouse. Brown = lumber. Tan = planks.");

    panel.cut_top(4);
    draw_chain_row(panel.cut_top(28), "Canopy", "Woodcutter",
        count_chain_stock(player, .WOODCUTTER, GOOD_LUMBER), 0);
    draw_chain_row(panel.cut_top(28), "Midcliff", "Sawmill",
        count_chain_stock(player, .SAWMILL, GOOD_LUMBER),
        count_chain_stock(player, .SAWMILL, GOOD_PLANKS));
    draw_chain_row(panel.cut_top(28), "Docks", "Warehouse",
        count_chain_stock(player, .WAREHOUSE, GOOD_LUMBER),
        count_chain_stock(player, .WAREHOUSE, GOOD_PLANKS));

    panel.cut_top(6);
    transit := panel.cut_top(24);
    ts.color = {0.85, 0.75, 0.45, 1};
    UI.text(transit, ts, "In transit  lumber %   planks %", {
        count_hauls_of_good(player, GOOD_LUMBER),
        count_hauls_of_good(player, GOOD_PLANKS)
    });

    panel.cut_top(8);
    btn_row := panel.cut_top(44);
    bs := UI.default_button_settings();
    bs.press_scaling = 0.35;
    btn_ts := UI.default_text_settings();
    btn_ts.size = 22;
    btn_ts.color = {1, 1, 1, 1};

    seed_rect := btn_row.cut_left(150);
    bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png");
    if UI.button(seed_rect, bs, btn_ts, "Seed Demo").clicked {
        seed_lumber_demo(player);
    }

    // Warehouse stores planks only. Lumber stays on canopy / mill — no Take Lumber.
    btn_row.cut_left(8);
    take_p := btn_row.cut_left(140);
    bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_1.png");
    if UI.button(take_p, bs, btn_ts, "Take Planks").clicked {
        if !withdraw_warehouse_planks(player) {
            Notifier.notify(player, "No warehouse planks yet.");
        }
    }

    btn_row.cut_left(8);
    close_rect := btn_row.cut_left(100);
    bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png");
    if UI.button(close_rect, bs, btn_ts, "Close").clicked {
        player.cove_open = false;
    }
}

draw_chain_row :: proc(row: Rect, shelf_name: string, building: string, lumber: int, planks: int) {
    UI.quad(row, core_globals.white_sprite, {0.12, 0.13, 0.16, 0.7});
    ts := UI.default_text_settings();
    ts.size = 22;
    ts.color = {1, 1, 1, 1};
    ts.halign = .LEFT;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 1;
    ts.outline_color = {0, 0, 0, 1};

    shelf_rect := row.cut_left(90).inset(6, 0, 0, 0);
    UI.text(shelf_rect, ts, shelf_name);

    name_rect := row.cut_left(120);
    UI.text(name_rect, ts, building);

    ts.color = {0.82, 0.58, 0.32, 1};
    lum_rect := row.cut_left(90);
    UI.text(lum_rect, ts, "Lumber %", {lumber});

    ts.color = {0.90, 0.78, 0.48, 1};
    UI.text(row.inset(0, 6, 0, 0), ts, "Planks %", {planks});
}
