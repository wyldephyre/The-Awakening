OUTPOST_GRID_SIZE :: 2.0;
OUTPOST_PLOT_RADIUS :: 8.0;
MAX_STRUCTURES :: 12;

// Cliff shelves are first-class build pads (Corsair Cove loop).
// grid_x = slot along the shelf. shelf = terrace height (0 docks .. 2 canopy).
SHELF_COUNT :: 3;
SHELF_SLOTS :: 3;
SHELF_HEIGHT :: 3.5;
// East of THAT player's position at first seed — not a shared world (10, 0).
COVE_EAST_OFFSET :: 10.0;

WOODCUTTER_LUMBER_CAP :: 8;
SAWMILL_LUMBER_CAP :: 4;
SAWMILL_PLANK_CAP :: 4;
WAREHOUSE_GOODS_CAP :: 24;

Structure_Kind :: enum {
    WALL;
    WATCHTOWER;
    WORKSHOP;
    STORAGE;
    WOODCUTTER;
    SAWMILL;
    WAREHOUSE;
}

STRUCTURE_COUNT :: 7;

Structure_Level_Data :: struct {
    hp: int;
    bonus: int;
}

Structure_Def :: class {
    kind: Structure_Kind;
    name: string;
    max_level: int;
    costs: [3][..]Recipe_Ingredient;
    levels: [3]Structure_Level_Data;
}

all_structure_defs: [..]Structure_Def;

register_structure_defs :: proc() {
    // Wall - defensive barrier
    wall := new(Structure_Def);
    wall.kind = .WALL;
    wall.name = "Wall";
    wall.max_level = 3;
    wall.levels[0] = Structure_Level_Data{50, 0};
    wall.levels[1] = Structure_Level_Data{100, 0};
    wall.levels[2] = Structure_Level_Data{200, 0};
    wall.costs[0]->append(Recipe_Ingredient{.SALVAGE, 5});
    wall.costs[0]->append(Recipe_Ingredient{.SCRAP_METAL, 3});
    wall.costs[1]->append(Recipe_Ingredient{.SCRAP_METAL, 6});
    wall.costs[1]->append(Recipe_Ingredient{.ALLOY_COMPONENT, 2});
    wall.costs[2]->append(Recipe_Ingredient{.ALLOY_COMPONENT, 5});
    wall.costs[2]->append(Recipe_Ingredient{.FACTION_TECH, 2});
    all_structure_defs->append(wall);

    // Watchtower - increases nearby detection range
    tower := new(Structure_Def);
    tower.kind = .WATCHTOWER;
    tower.name = "Watchtower";
    tower.max_level = 3;
    tower.levels[0] = Structure_Level_Data{30, 5};
    tower.levels[1] = Structure_Level_Data{60, 8};
    tower.levels[2] = Structure_Level_Data{100, 12};
    tower.costs[0]->append(Recipe_Ingredient{.SALVAGE, 4});
    tower.costs[0]->append(Recipe_Ingredient{.WATER, 2});
    tower.costs[1]->append(Recipe_Ingredient{.FUEL_CELL, 3});
    tower.costs[1]->append(Recipe_Ingredient{.NEXUS_CRYSTAL, 2});
    tower.costs[2]->append(Recipe_Ingredient{.VOLATILE_SHARD, 2});
    tower.costs[2]->append(Recipe_Ingredient{.FACTION_TECH, 3});
    all_structure_defs->append(tower);

    // Workshop - reduces crafting cost or unlocks recipes
    workshop := new(Structure_Def);
    workshop.kind = .WORKSHOP;
    workshop.name = "Workshop";
    workshop.max_level = 3;
    workshop.levels[0] = Structure_Level_Data{40, 1};
    workshop.levels[1] = Structure_Level_Data{80, 2};
    workshop.levels[2] = Structure_Level_Data{120, 3};
    workshop.costs[0]->append(Recipe_Ingredient{.SCRAP_METAL, 5});
    workshop.costs[0]->append(Recipe_Ingredient{.FOOD, 3});
    workshop.costs[1]->append(Recipe_Ingredient{.ALLOY_COMPONENT, 4});
    workshop.costs[1]->append(Recipe_Ingredient{.FUEL_CELL, 3});
    workshop.costs[2]->append(Recipe_Ingredient{.FACTION_TECH, 4});
    workshop.costs[2]->append(Recipe_Ingredient{.RARE_BIOLOGIC, 2});
    all_structure_defs->append(workshop);

    // Storage - expands inventory capacity
    storage := new(Structure_Def);
    storage.kind = .STORAGE;
    storage.name = "Storage";
    storage.max_level = 3;
    storage.levels[0] = Structure_Level_Data{35, 5};
    storage.levels[1] = Structure_Level_Data{70, 10};
    storage.levels[2] = Structure_Level_Data{100, 15};
    storage.costs[0]->append(Recipe_Ingredient{.SALVAGE, 6});
    storage.costs[0]->append(Recipe_Ingredient{.FOOD, 2});
    storage.costs[1]->append(Recipe_Ingredient{.SCRAP_METAL, 5});
    storage.costs[1]->append(Recipe_Ingredient{.NEXUS_CRYSTAL, 3});
    storage.costs[2]->append(Recipe_Ingredient{.ALLOY_COMPONENT, 4});
    storage.costs[2]->append(Recipe_Ingredient{.VOLATILE_SHARD, 3});
    all_structure_defs->append(storage);

    // Woodcutter - canopy producer (implicit grove on its shelf)
    woodcutter := new(Structure_Def);
    woodcutter.kind = .WOODCUTTER;
    woodcutter.name = "Woodcutter";
    woodcutter.max_level = 1;
    woodcutter.levels[0] = Structure_Level_Data{40, 0};
    woodcutter.costs[0]->append(Recipe_Ingredient{.SALVAGE, 4});
    all_structure_defs->append(woodcutter);

    // Sawmill - converts lumber -> planks
    sawmill := new(Structure_Def);
    sawmill.kind = .SAWMILL;
    sawmill.name = "Sawmill";
    sawmill.max_level = 1;
    sawmill.levels[0] = Structure_Level_Data{45, 0};
    sawmill.costs[0]->append(Recipe_Ingredient{.SALVAGE, 3});
    sawmill.costs[0]->append(Recipe_Ingredient{.SCRAP_METAL, 2});
    all_structure_defs->append(sawmill);

    // Warehouse - chain store (not STORAGE inventory bonus)
    warehouse := new(Structure_Def);
    warehouse.kind = .WAREHOUSE;
    warehouse.name = "Warehouse";
    warehouse.max_level = 1;
    warehouse.levels[0] = Structure_Level_Data{50, 0};
    warehouse.costs[0]->append(Recipe_Ingredient{.SALVAGE, 5});
    all_structure_defs->append(warehouse);
}

get_structure_def :: proc(kind: Structure_Kind) -> Structure_Def {
    for def: all_structure_defs {
        if def.kind == kind return def;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Placed structure data (serializable for save)
// ---------------------------------------------------------------------------

Placed_Structure :: class {
    kind_index: int @ao_serialize;
    level: int @ao_serialize;
    grid_x: int @ao_serialize;
    grid_y: int @ao_serialize;
    shelf: int @ao_serialize;
    hp: int @ao_serialize;
    stock_lumber: int @ao_serialize;
    stock_planks: int @ao_serialize;
}

Outpost_Data :: class {
    version: int @ao_serialize;
    center_x: float @ao_serialize;
    center_y: float @ao_serialize;
    structures: [..]Placed_Structure @ao_serialize;
    demo_seeded: bool @ao_serialize;
}

OUTPOST_SAVE_VERSION :: 2;

Haul_Job :: class {
    good: int;
    start_time: float;
    from_x: float;
    from_y: float;
    to_x: float;
    to_y: float;
    dest_kind_index: int;
}

// ---------------------------------------------------------------------------
// Per-player outpost runtime state
// ---------------------------------------------------------------------------

Player_Outpost :: class {
    data: Outpost_Data;
    entities: [..]Entity;
    initialized: bool;
    next_prod_time: float;
    hauls: [..]Haul_Job;
}

init_player_outpost :: proc(player: Player) {
    if player.outpost == null {
        player.outpost = new(Player_Outpost);
    }
    outpost := player.outpost;

    outpost.data = new(Outpost_Data);
    if !Save.try_get_json(player, "outpost_data", ref outpost.data) {
        outpost.data = new(Outpost_Data);
        outpost.data.version = OUTPOST_SAVE_VERSION;
        // World offset is applied at first seed / unlock_cove so it is east of
        // THIS player (Snyder arrival), not a shared lake-origin (10, 0).
    }

    rebuild_outpost_entities(player);
    apply_outpost_bonuses(player);
    outpost.initialized = true;

    // Lake tutorial comes next. Cove auto-seed waits for Snyder arrival.
    if player.cove_unlocked {
        if !outpost.data.demo_seeded {
            if outpost.data.structures.count == 0 {
                seed_lumber_demo(player);
            }
        }
    }
}

place_cove_east_of_player :: proc(player: Player) {
    if player.outpost == null return;
    origin := player.entity.world_position;
    player.outpost.data.center_x = origin.x + COVE_EAST_OFFSET;
    player.outpost.data.center_y = origin.y;
}

// Snyder arrival (next slice) should call this. Do not call from lake cold-open.
// DEBUG CHEAT: editor HUD button "Unlock Cove (debug)" also calls this.
unlock_cove :: proc(player: Player) {
    if player.cove_unlocked return;
    player.cove_unlocked = true;
    save_player_data(player);

    if player.outpost == null {
        init_player_outpost(player);
        return;
    }

    if !player.outpost.data.demo_seeded {
        if player.outpost.data.structures.count == 0 {
            seed_lumber_demo(player);
        }
    }
}

save_outpost :: proc(player: Player) {
    if player.outpost == null return;
    Save.set_json(player, "outpost_data", ref player.outpost.data);
}

// ---------------------------------------------------------------------------
// Entity management
// ---------------------------------------------------------------------------

rebuild_outpost_entities :: proc(player: Player) {
    outpost := player.outpost;
    if outpost == null return;

    // Destroy old entities
    for ent: outpost.entities {
        if ent != null {
            ent->destroy();
        }
    }
    outpost.entities->clear();

    // Spawn entities for each structure
    for placed: outpost.data.structures {
        spawn_structure_entity(outpost, placed);
    }
}

structure_world_pos :: proc(outpost: Player_Outpost, placed: Placed_Structure) -> v2 {
    world_x := outpost.data.center_x + placed.grid_x.(float) * OUTPOST_GRID_SIZE;
    world_y := outpost.data.center_y + placed.shelf.(float) * SHELF_HEIGHT;
    return {world_x, world_y};
}

spawn_structure_entity :: proc(outpost: Player_Outpost, placed: Placed_Structure) {
    ent := Scene.create_entity();
    pos := structure_world_pos(outpost, placed);
    ent->set_local_position(pos);

    sprite := ent->add_component(Sprite_Renderer);
    sprite->set_texture(core_globals.white_sprite);
    sprite.depth_offset = 0.0;

    def := get_structure_def_by_index(placed.kind_index);
    if def != null {
        color := get_structure_color(def.kind);
        scale_val := 0.8 + placed.level.(float) * 0.3;
        sprite.color = color;
        ent->set_local_scale({scale_val, scale_val});
    }

    outpost.entities->append(ent);
}

get_structure_def_by_index :: proc(index: int) -> Structure_Def {
    if index < 0 return null;
    if index >= all_structure_defs.count return null;
    return all_structure_defs[index];
}

get_structure_color :: proc(kind: Structure_Kind) -> v4 {
    switch kind {
        case .WALL:       return {0.5, 0.5, 0.5, 1.0};
        case .WATCHTOWER: return {0.3, 0.6, 0.9, 1.0};
        case .WORKSHOP:   return {0.9, 0.6, 0.2, 1.0};
        case .STORAGE:    return {0.4, 0.8, 0.4, 1.0};
        case .WOODCUTTER: return {0.45, 0.28, 0.12, 1.0};
        case .SAWMILL:    return {0.78, 0.58, 0.28, 1.0};
        case .WAREHOUSE:  return {0.38, 0.44, 0.40, 1.0};
    }
    return {1, 1, 1, 1};
}

get_kind_index :: proc(kind: Structure_Kind) -> int {
    switch kind {
        case .WALL:       return 0;
        case .WATCHTOWER: return 1;
        case .WORKSHOP:   return 2;
        case .STORAGE:    return 3;
        case .WOODCUTTER: return 4;
        case .SAWMILL:    return 5;
        case .WAREHOUSE:  return 6;
    }
    return 0;
}

get_shelf_name :: proc(shelf: int) -> string {
    if shelf == 2 return "Canopy";
    if shelf == 1 return "Midcliff";
    return "Docks";
}

is_production_kind :: proc(kind: Structure_Kind) -> bool {
    if kind == .WOODCUTTER return true;
    if kind == .SAWMILL return true;
    if kind == .WAREHOUSE return true;
    return false;
}

find_structure_of_kind :: proc(player: Player, kind: Structure_Kind) -> Placed_Structure {
    if player.outpost == null return null;
    want := get_kind_index(kind);
    for placed: player.outpost.data.structures {
        if placed.kind_index == want {
            return placed;
        }
    }
    return null;
}

// ---------------------------------------------------------------------------
// Build / upgrade / remove
// ---------------------------------------------------------------------------

can_afford_structure :: proc(player: Player, kind: Structure_Kind, level: int) -> bool {
    def := get_structure_def(kind);
    if def == null return false;
    if level < 0 return false;
    if level >= def.max_level return false;

    for ing: def.costs[level] {
        have := count_resource_in_inventory(player, ing.resource_type);
        if have < ing.amount return false;
    }
    return true;
}

spend_structure_cost :: proc(player: Player, kind: Structure_Kind, level: int) {
    def := get_structure_def(kind);
    if def == null return;
    for ing: def.costs[level] {
        remaining := ing.amount;
        for i: 0..player.default_inventory.capacity-1 {
            if remaining <= 0 break;
            item := player.default_inventory->get_item(i);
            if item == null continue;
            defn := item->get_definition();
            res_defn := defn.(Resource_Definition);
            if res_defn == null continue;
            if res_defn.resource_type != ing.resource_type continue;

            stack := item.quantity.(int);
            if stack <= remaining {
                remaining -= stack;
                Items.destroy_item_instance(item);
            } else {
                Items.destroy_item_instance(item, remaining.(s64));
                remaining = 0;
            }
        }
    }
}

is_grid_occupied :: proc(player: Player, gx: int, shelf: int) -> bool {
    if player.outpost == null return false;
    for placed: player.outpost.data.structures {
        if placed.grid_x == gx {
            if placed.shelf == shelf {
                return true;
            }
        }
    }
    return false;
}

is_valid_shelf_cell :: proc(gx: int, shelf: int) -> bool {
    if gx < 0 return false;
    if gx >= SHELF_SLOTS return false;
    if shelf < 0 return false;
    if shelf >= SHELF_COUNT return false;
    return true;
}

is_within_plot :: proc(gx: int, gy: int) -> bool {
    // gy is the shelf index. Cliff pads replace the old circular plot.
    return is_valid_shelf_cell(gx, gy);
}

bind_placed_cell :: proc(placed: Placed_Structure, gx: int, shelf: int) {
    placed.grid_x = gx;
    placed.shelf = shelf;
    placed.grid_y = shelf;
}

append_placed_structure :: proc(player: Player, kind: Structure_Kind, gx: int, shelf: int) -> Placed_Structure {
    placed := new(Placed_Structure);
    placed.kind_index = get_kind_index(kind);
    placed.level = 1;
    def := get_structure_def(kind);
    if def != null {
        placed.hp = def.levels[0].hp;
    }
    bind_placed_cell(placed, gx, shelf);
    player.outpost.data.structures->append(placed);
    spawn_structure_entity(player.outpost, placed);
    return placed;
}

place_structure :: proc(player: Player, kind: Structure_Kind, gx: int, gy: int) -> bool {
    if player.outpost == null return false;
    if player.outpost.data.structures.count >= MAX_STRUCTURES return false;
    if !is_valid_shelf_cell(gx, gy) return false;
    if is_grid_occupied(player, gx, gy) return false;
    if !can_afford_structure(player, kind, 0) return false;

    spend_structure_cost(player, kind, 0);

    def := get_structure_def(kind);
    append_placed_structure(player, kind, gx, gy);
    apply_outpost_bonuses(player);
    save_outpost(player);

    if def != null {
        Notifier.notify(player, format_string("Built % on %!", {def.name, get_shelf_name(gy)}));
    }
    on_quest_structure_built(player);
    return true;
}

place_structure_free :: proc(player: Player, kind: Structure_Kind, gx: int, shelf: int) -> bool {
    if player.outpost == null return false;
    if player.outpost.data.structures.count >= MAX_STRUCTURES return false;
    if !is_valid_shelf_cell(gx, shelf) return false;
    if is_grid_occupied(player, gx, shelf) return false;

    append_placed_structure(player, kind, gx, shelf);
    apply_outpost_bonuses(player);
    return true;
}

seed_lumber_demo :: proc(player: Player) -> bool {
    if player.outpost == null return false;

    // First seed parks the triangle east of THIS player's current position.
    if !player.outpost.data.demo_seeded {
        place_cove_east_of_player(player);
        rebuild_outpost_entities(player);
    }

    if find_structure_of_kind(player, .WOODCUTTER) == null {
        place_structure_free(player, .WOODCUTTER, 1, 2);
    }
    if find_structure_of_kind(player, .SAWMILL) == null {
        place_structure_free(player, .SAWMILL, 1, 1);
    }
    if find_structure_of_kind(player, .WAREHOUSE) == null {
        place_structure_free(player, .WAREHOUSE, 1, 0);
    }

    player.outpost.data.demo_seeded = true;
    player.outpost.hauls->clear();
    save_outpost(player);

    cutter := find_structure_of_kind(player, .WOODCUTTER);
    mill := find_structure_of_kind(player, .SAWMILL);
    warehouse := find_structure_of_kind(player, .WAREHOUSE);
    if cutter == null return false;
    if mill == null return false;
    if warehouse == null return false;

    Notifier.notify(player, "Cove demo: lumber drops Canopy -> Midcliff -> Docks.");
    return true;
}

upgrade_structure :: proc(player: Player, index: int) -> bool {
    if player.outpost == null return false;
    if index < 0 return false;
    if index >= player.outpost.data.structures.count return false;

    placed := player.outpost.data.structures[index];
    def := get_structure_def_by_index(placed.kind_index);
    if def == null return false;
    if placed.level >= def.max_level return false;

    next_level := placed.level;
    if !can_afford_structure(player, def.kind, next_level) return false;

    spend_structure_cost(player, def.kind, next_level);
    placed.level += 1;
    placed.hp = def.levels[placed.level - 1].hp;

    rebuild_outpost_entities(player);
    apply_outpost_bonuses(player);
    save_outpost(player);

    Notifier.notify(player, format_string("Upgraded % to Lv%!", {def.name, placed.level}));
    on_quest_structure_upgraded(player);
    return true;
}

remove_structure :: proc(player: Player, index: int) -> bool {
    if player.outpost == null return false;
    if index < 0 return false;
    if index >= player.outpost.data.structures.count return false;

    player.outpost.data.structures->unordered_remove_by_index(index);
    player.outpost.hauls->clear();
    rebuild_outpost_entities(player);
    apply_outpost_bonuses(player);
    save_outpost(player);
    return true;
}

// ---------------------------------------------------------------------------
// Bonus calculation
// ---------------------------------------------------------------------------

apply_outpost_bonuses :: proc(player: Player) {
    if player.outpost == null return;
    extra_capacity := 0;

    for placed: player.outpost.data.structures {
        def := get_structure_def_by_index(placed.kind_index);
        if def == null continue;
        if def.kind == .STORAGE {
            lvl_idx := placed.level - 1;
            if lvl_idx < 0 { lvl_idx = 0; }
            extra_capacity += def.levels[lvl_idx].bonus;
        }
    }

    Items.set_capacity(player.default_inventory, INVENTORY_CAPACITY + extra_capacity.(s64));
}

// ---------------------------------------------------------------------------
// World-space outpost visualization
// ---------------------------------------------------------------------------

draw_outpost_world :: proc(player: Player) {
    if player.outpost == null return;
    if !player.outpost.initialized return;

    UI.push_world_draw_context();
    defer UI.pop_draw_context();

    center := v2{player.outpost.data.center_x, player.outpost.data.center_y};

    UI.push_z(center.y - 0.5);
    defer UI.pop_z();

    if player.cove_unlocked {
        draw_cove_shelves(player.outpost);
    }

    // Labels above structures
    ts := UI.default_text_settings();
    ts.size = 0.25;
    ts.color = {1, 1, 1, 0.8};
    ts.halign = .CENTER;
    ts.valign = .BOTTOM;
    ts.do_outline = true;
    ts.outline_thickness = 1;
    ts.outline_color = {0, 0, 0, 0.6};

    for placed: player.outpost.data.structures {
        def := get_structure_def_by_index(placed.kind_index);
        if def == null continue;

        pos := structure_world_pos(player.outpost, placed);
        label_pos := v2{pos.x, pos.y + 1.0};
        label_rect := Rect{label_pos, label_pos}->grow(0.15, 1.6, 0.0, 1.6);

        if is_production_kind(def.kind) {
            UI.text(label_rect, ts, "%  L:% P:%", {def.name, placed.stock_lumber, placed.stock_planks});
        } else {
            UI.text(label_rect, ts, "% Lv%  %", {def.name, placed.level, get_shelf_name(placed.shelf)});
        }
    }
}

draw_cove_shelves :: proc(outpost: Player_Outpost) {
    if outpost == null return;

    ts := UI.default_text_settings();
    ts.size = 0.28;
    ts.color = {0.95, 0.88, 0.72, 0.85};
    ts.halign = .LEFT;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 1;
    ts.outline_color = {0, 0, 0, 0.55};

    for s: 0..SHELF_COUNT-1 {
        y := outpost.data.center_y + s.(float) * SHELF_HEIGHT;
        left_x := outpost.data.center_x - OUTPOST_GRID_SIZE * 0.5;
        right_x := outpost.data.center_x + (SHELF_SLOTS.(float) - 0.5) * OUTPOST_GRID_SIZE;
        mid_x := (left_x + right_x) * 0.5;

        pad := Rect{{left_x, y - 0.35}, {right_x, y + 0.15}};
        color := v4{0.28, 0.30, 0.38, 0.28};
        if s == 1 {
            color = {0.42, 0.32, 0.22, 0.32};
        }
        if s == 2 {
            color = {0.22, 0.38, 0.18, 0.30};
        }
        UI.quad(pad, core_globals.white_sprite, color);

        face := Rect{{left_x, y - 0.85}, {right_x, y - 0.35}};
        face_color := color;
        face_color.w = 0.18;
        UI.quad(face, core_globals.white_sprite, face_color);

        name_pos := v2{left_x - 0.15, y};
        name_rect := Rect{name_pos, name_pos}->grow(0.2, 0.1, 0.2, 1.6);
        UI.text(name_rect, ts, get_shelf_name(s));

        // Implicit canopy stand — not a second gathering system.
        if s == 2 {
            draw_canopy_grove(outpost, y);
        }
    }
}

draw_canopy_grove :: proc(outpost: Player_Outpost, shelf_y: float) {
    trunk := v4{0.32, 0.20, 0.10, 0.85};
    leaf := v4{0.20, 0.48, 0.22, 0.75};
    x0 := outpost.data.center_x;
    x2 := outpost.data.center_x + 2.0 * OUTPOST_GRID_SIZE;

    t0 := v2{x0, shelf_y + 0.35};
    UI.quad(Rect{t0, t0}->grow(0.35, 0.08, 0.05, 0.08), core_globals.white_sprite, trunk);
    UI.quad(Rect{t0 + v2{0, 0.45}, t0 + v2{0, 0.45}}->grow(0.22, 0.22, 0.22, 0.22), core_globals.white_sprite, leaf);

    t2 := v2{x2, shelf_y + 0.35};
    UI.quad(Rect{t2, t2}->grow(0.35, 0.08, 0.05, 0.08), core_globals.white_sprite, trunk);
    UI.quad(Rect{t2 + v2{0, 0.45}, t2 + v2{0, 0.45}}->grow(0.22, 0.22, 0.22, 0.22), core_globals.white_sprite, leaf);
}
