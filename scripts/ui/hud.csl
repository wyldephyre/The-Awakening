// Top-left HUD column. Shared with quest_ui so the tracker cannot
// paint over Muscle/Spark/Edge (Sprint 8 inset(80) collided with Muscle).
HUD_LEFT_PAD :: 16.0;
HUD_TOP_PAD :: 16.0;
HUD_COLUMN_WIDTH :: 280.0;
HUD_LABEL_WIDTH :: 100.0;
HUD_VALUE_WIDTH :: 70.0;
HUD_HP_HEIGHT :: 40.0;
HUD_HP_GAP :: 10.0;
HUD_BAR_HEIGHT :: 36.0;
HUD_BAR_GAP :: 6.0;
HUD_QUEST_GAP :: 16.0;
HUD_QUEST_HEIGHT :: 88.0;

// HP + Muscle/Spark/Edge, including the gap after the last pool bar.
hud_pool_stack_height :: proc() -> float {
    return HUD_HP_HEIGHT + HUD_HP_GAP + (HUD_BAR_HEIGHT + HUD_BAR_GAP) * 3.0;
}

draw_hud :: proc(player: Player) {
    safe := UI.get_safe_screen_rect();

    // Health + Muscle / Spark / Edge stacked top-left with room for labels.
    pool_area := safe.top_left_rect().grow(0, HUD_COLUMN_WIDTH, hud_pool_stack_height(), 0).offset(HUD_LEFT_PAD, -HUD_TOP_PAD);

    draw_health_bar(ref pool_area, player);
    draw_pool_bar(ref pool_area, "Muscle", player.muscle, player.muscle_max, {0.8, 0.2, 0.2, 1.0});
    draw_pool_bar(ref pool_area, "Spark", player.spark, player.spark_max, {0.3, 0.5, 0.9, 1.0});
    draw_pool_bar(ref pool_area, "Edge", player.edge, player.edge_max, {0.2, 0.8, 0.3, 1.0});

    // Ability CDs sit above the hotbar, not in the top-left stack.
    draw_ability_cooldown_strip(player);

    // Zone indicator in top-right
    zone := get_zone(player.entity.world_position);
    zone_rect := safe.top_right_rect().grow(0, 0, 40, 120).offset(-20, -20);
    ts := UI.default_text_settings();
    ts.size = 36;
    ts.color = {1, 1, 1, 1};
    ts.halign = .RIGHT;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 2;
    ts.outline_color = {0, 0, 0, 1};
    UI.text(zone_rect, ts, "Zone %", {zone});

    // Craft button - right side under zone
    craft_rect := safe.top_right_rect().grow(0, 0, 37, 105).offset(-20, -75);
    craft_bs := UI.default_button_settings();
    craft_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_1.png");
    craft_bs.press_scaling = 0.35;
    craft_ts := UI.default_text_settings();
    craft_ts.size = 30;
    craft_ts.color = {1, 1, 1, 1};
    if UI.button(craft_rect, craft_bs, craft_ts, "Craft").clicked {
        player.crafting_open = !player.crafting_open;
        player.build_mode = false;
        player.gear_open = false;
        player.quest_log_open = false;
    }

    // Build button - right side under craft
    build_rect := safe.top_right_rect().grow(0, 0, 37, 105).offset(-20, -130);
    build_bs := UI.default_button_settings();
    build_bs.press_scaling = 0.35;
    build_ts := UI.default_text_settings();
    build_ts.size = 30;
    build_ts.color = {1, 1, 1, 1};

    if player.build_mode {
        build_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_5.png");
    } else {
        build_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_9.png");
    }
    if UI.button(build_rect, build_bs, build_ts, "Build").clicked {
        player.build_mode = !player.build_mode;
        player.build_selected = -1;
        player.crafting_open = false;
        player.gear_open = false;
        player.quest_log_open = false;
    }

    // Gear button - right side under build
    gear_rect := safe.top_right_rect().grow(0, 0, 37, 105).offset(-20, -185);
    gear_bs := UI.default_button_settings();
    gear_bs.press_scaling = 0.35;
    gear_ts := UI.default_text_settings();
    gear_ts.size = 30;
    gear_ts.color = {1, 1, 1, 1};

    if player.gear_open {
        gear_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_7.png");
    } else {
        gear_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_9.png");
    }
    if UI.button(gear_rect, gear_bs, gear_ts, "Gear").clicked {
        player.gear_open = !player.gear_open;
        player.crafting_open = false;
        player.build_mode = false;
        player.quest_log_open = false;
    }

    // Quest log button - right side under gear
    quest_rect := safe.top_right_rect().grow(0, 0, 37, 105).offset(-20, -240);
    quest_bs := UI.default_button_settings();
    quest_bs.press_scaling = 0.35;
    quest_ts := UI.default_text_settings();
    quest_ts.size = 30;
    quest_ts.color = {1, 1, 1, 1};

    if player.quest_log_open {
        quest_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_5.png");
    } else {
        quest_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_9.png");
    }
    if UI.button(quest_rect, quest_bs, quest_ts, "Quests").clicked {
        player.quest_log_open = !player.quest_log_open;
        player.crafting_open = false;
        player.build_mode = false;
        player.gear_open = false;
    }
}

// Quest tracker parks here - same left edge/width as the pool column, below it.
hud_quest_tracker_rect :: proc() -> Rect {
    safe := UI.get_safe_screen_rect();
    top := HUD_TOP_PAD + hud_pool_stack_height() + HUD_QUEST_GAP;
    return safe.top_left_rect().grow(0, HUD_COLUMN_WIDTH, HUD_QUEST_HEIGHT, 0).offset(HUD_LEFT_PAD, -top);
}

draw_health_bar :: proc(area: ref Rect, player: Player) {
    bar_rect := area.cut_top(HUD_HP_HEIGHT);
    label_rect := bar_rect.cut_left(HUD_LABEL_WIDTH);
    value_rect := bar_rect.cut_right(HUD_VALUE_WIDTH);
    fill_area := bar_rect;

    UI.quad(fill_area, core_globals.white_sprite, {0, 0, 0, 0.5});

    pct := 0.0;
    if player.hp_max > 0 {
        pct = player.hp.(float) / player.hp_max.(float);
    }
    pct = clamp(pct, 0.0, 1.0);

    if pct > 0 {
        filled := fill_area.subrect(0, 0, pct, 1);
        fill_color := lerp(v4{0.8, 0.1, 0.1, 1.0}, {0.1, 0.8, 0.1, 1.0}, pct);
        UI.quad(filled, core_globals.white_sprite, fill_color);
    }

    ts := hud_bar_text_settings();
    UI.text(label_rect, ts, "HP");
    ts.halign = .RIGHT;
    UI.text(value_rect, ts, "%/%", {player.hp, player.hp_max});

    area.cut_top(HUD_HP_GAP);
}

draw_pool_bar :: proc(area: ref Rect, name: string, current: int, max_val: int, color: v4) {
    bar_rect := area.cut_top(HUD_BAR_HEIGHT);
    label_rect := bar_rect.cut_left(HUD_LABEL_WIDTH);
    value_rect := bar_rect.cut_right(HUD_VALUE_WIDTH);
    fill_area := bar_rect;

    UI.quad(fill_area, core_globals.white_sprite, {0, 0, 0, 0.5});

    pct := 0.0;
    if max_val > 0 {
        pct = current.(float) / max_val.(float);
    }
    if pct > 1.0 {
        pct = 1.0;
    }
    filled := fill_area.subrect(0, 0, pct, 1);
    UI.quad(filled, core_globals.white_sprite, color);

    ts := hud_bar_text_settings();
    UI.text(label_rect, ts, name);
    ts.halign = .RIGHT;
    UI.text(value_rect, ts, "%/%", {current, max_val});

    area.cut_top(HUD_BAR_GAP);
}

hud_bar_text_settings :: proc() -> Text_Settings {
    ts := UI.default_text_settings();
    ts.size = 26;
    ts.color = {1, 1, 1, 1};
    ts.halign = .LEFT;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 2;
    ts.outline_color = {0, 0, 0, 1};
    return ts;
}

// Compact CD chips just above the inventory hotbar (bottom-center).
// Engine ability buttons still draw their own numbers bottom-right.
draw_ability_cooldown_strip :: proc(player: Player) {
    if player.abilities.count <= 0 return;

    cooling := 0;
    for i: 0..player.abilities.count-1 {
        if player.abilities[i].current_cooldown > 0 {
            cooling += 1;
        }
    }
    if cooling <= 0 return;

    safe := UI.get_safe_screen_rect();
    // Fixed chip row just above Items.draw_hotbar (bottom-center, ~150px tall).
    strip := safe.bottom_center_rect().grow(16, 180, 16, 180).offset(0, 188);
    slot_w := strip.width() / cooling.(float);

    ts := UI.default_text_settings();
    ts.size = 20;
    ts.color = {1, 1, 1, 1};
    ts.halign = .CENTER;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 2;
    ts.outline_color = {0, 0, 0, 1};

    for i: 0..player.abilities.count-1 {
        ability := player.abilities[i];
        if ability.current_cooldown <= 0 continue;

        chip := strip.cut_left(slot_w);
        strip.cut_left(6);
        UI.quad(chip, core_globals.white_sprite, {0, 0, 0, 0.55});
        UI.text(chip, ts, "% %", {ability.name, format_float(ability.current_cooldown, decimals=1)});
    }
}
